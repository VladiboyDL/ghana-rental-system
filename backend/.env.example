# Database
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Environment
NODE_ENV=development
PORT=5000

# AWS S3 for file uploads
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=eu-west-1
AWS_S3_BUCKET=ghana-rental-uploads

# Mobile App
MOBILE_APP_SCHEME=ghanarent

# Simulation Mode (for demo purposes)
SIMULATION_MODE=true

# ===========================================
# NOTIFICATION SERVICES
# ===========================================

# Twilio WhatsApp (Primary notification channel)
# Get credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# For Sandbox: whatsapp:+14155238886 (Twilio's sandbox number)
# For Production: Your purchased WhatsApp-enabled number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set to 'true' to enable WhatsApp notifications
WHATSAPP_ENABLED=false

# n8n Webhook Integration (Secondary/workflow automation)
# Your n8n webhook URL (e.g., https://your-n8n.domain.com/webhook/xxx)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/ghana-rental
# Set to 'true' to enable n8n webhooks
N8N_ENABLED=false
# Optional: API key for webhook authentication
N8N_API_KEY=
